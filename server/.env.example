# ============================================================
# 腾讯云 COS 配置示例 —— 复制本文件为 .env 并填入真实值
# （.env 已被 .gitignore 忽略不会提交；.env.example 会提交作为参考）
# ============================================================

# SecretId / SecretKey —— 访问密钥（COS 与 OCR 通用，同一腾讯云 CAM 密钥）
# 获取：https://console.cloud.tencent.com/cam/capi（新建密钥，或用子账号密钥）
# 建议：用子账号（授权 COS 读写 + OCR 调用），不要用主账号密钥
COS_SECRET_ID=your-secret-id
COS_SECRET_KEY=your-secret-key

# Bucket 名称（含 AppId 后缀，如 driveease-1250000000）
# 获取：https://console.cloud.tencent.com/cos/bucket（bucket 名称即此格式）
COS_BUCKET=driveease-1250000000

# 地域（bucket 所在地域）
# 获取：bucket 列表里的「地域」列，如 ap-guangzhou / ap-shanghai / ap-beijing
COS_REGION=ap-guangzhou
